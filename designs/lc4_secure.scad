// lc4_secure — 4-pen single-part lip-cradle at the SHALLOW 36deg angle so pens
// rest securely (no cover). Pull each pen straight out the front over the little
// lip. Footprint depth ~3.1in (intentionally over the old 2.5in width spec).
include <lipcradle_lib.scad>
lipcradle(n=4, phi=36, P=22.5, liph=4.5);
